{
  "name": "joao-job-blog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "preinstall": "bun scripts/verify-bun-version.ts",
    "predev": "bun run verify:bun",
    "dev": "vite",
    "prebuild": "bun run verify:bun",
    "build": "bun run typecheck && vite build",
    "prepreview": "bun run verify:bun",
    "preview": "vite preview",
    "pretypecheck": "bun run verify:bun",
    "verify:bun": "bun scripts/verify-bun-version.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@icons-pack/react-simple-icons": "^13.13.0",
    "@tanstack/react-router": "^1.170.18",
    "lucide-react": "^1.25.0",
